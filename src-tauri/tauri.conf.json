{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DoubaoIME ThemeTool",
  "version": "1.0.2",
  "identifier": "local.doubaoime.darkmode",
  "build": {
    "beforeBuildCommand": "node scripts/check-public-build.mjs",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DoubaoIME ThemeTool",
        "width": 464,
        "height": 480,
        "resizable": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
